<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BrobyggerPortal.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Datalag (svarer til SQLAlchemy + Alembic i Python-backend'en) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />

    <!-- Entra ID (Azure AD) JWT-validering — Microsofts førsteklasses bibliotek -->
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />

    <!-- Microsoft Graph (mail + Outlook-kalender) — token via Azure.Identity, kald via REST -->
    <PackageReference Include="Azure.Identity" Version="1.17.2" />

    <!-- OpenAPI / Swagger UI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

</Project>

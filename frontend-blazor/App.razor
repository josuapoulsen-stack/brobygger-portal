<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <LayoutView Layout="@typeof(MainLayout)">
                            <div class="wrap"><p class="muted">Du har ikke adgang til denne side.</p></div>
                        </LayoutView>
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="wrap"><p class="muted">Kontrollerer adgang…</p></div>
                </Authorizing>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="wrap"><p class="muted">Siden blev ikke fundet.</p></div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@page "/brobyggere"
@inject ApiClient Api

<div class="page-head">
    <div class="ph-id">
        <h1>Brobyggere</h1>
        <p class="ph-sub">@rows.Count frivillige · @rows.Sum(b => Math.Max(0, b.MaxActive - b.Active)) ledige pladser</p>
    </div>
    <div class="ph-act">
        <button @onclick="() => visForm = !visForm">@(visForm ? "Luk" : "Ny brobygger")</button>
    </div>
</div>
@if (error is not null) { <div class="status err">@error</div> }

<div class="row" style="margin:16px 0"><input class="soeg" placeholder="Søg navn eller hovedsæde…" @bind="search" @bind:event="oninput" /></div>

@if (!Filtered.Any()) { <div class="kort muted">Ingen brobyggere matcher.</div> }
<div class="rowcards">
    @foreach (var b in Filtered)
    {
        <div class="rowcard">
            <div class="rc-ini">@Initialer(b.Navn)</div>
            <div class="rc-main">
                <div class="rc-navn"><b><a href="brobyggere/@b.Id">@b.Navn</a></b></div>
                <div class="rc-meta">@Meta(b)</div>
            </div>
            <div class="rc-tal"><span class="num">@b.Active/@b.MaxActive</span><span class="rc-tal-l">kapacitet</span></div>
            <span class="smono @StatusFarve.Klasse(b.Status)">@b.Status</span>
            <div class="rc-act"><a class="btn-lnk" href="brobyggere/@b.Id">Åbn</a></div>
        </div>
    }
</div>

@if (visForm)
{
<form @onsubmit="Opret">
    <div><label>Navn *</label><input @bind="form.Navn" required /></div>
    <div><label>Telefon</label><input @bind="form.Telefon" /></div>
    <div><label>Hovedsæde</label><input @bind="form.Hq" /></div>
    <div>
        <label>Region</label>
        <input list="dl-region" @bind="form.Region" placeholder="Søg region …" />
        <datalist id="dl-region">
            <option value="Nord" /><option value="Kronjylland" /><option value="Aarhus" /><option value="Syd" />
            <option value="Sydvest" /><option value="Midt" /><option value="Sjælland" /><option value="Hovedstaden" />
        </datalist>
    </div>
    <div><label>Max forløb</label><input type="number" @bind="form.MaxActive" /></div>
    <div>
        <label>Status</label>
        <select @bind="form.Status">
            <option value="ny">Ny</option>
            <option value="aktiv">Aktiv</option>
            <option value="pause">Pause</option>
            <option value="inaktiv">Inaktiv</option>
        </select>
    </div>
    <div class="full"><button type="button" class="ghost" @onclick="() => visForm = false">Annullér</button><button type="submit">Opret brobygger</button></div>
</form>
}

@code {
    private List<Brobygger> rows = [];
    private BrobyggerCreate form = new();
    private string search = "";
    private bool visForm;
    private string? error;

    private static string Initialer(string navn)
    {
        var dele = (navn ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (dele.Length == 0) return "?";
        return dele.Length == 1 ? dele[0][..1].ToUpper() : (dele[0][..1] + dele[^1][..1]).ToUpper();
    }

    private static string Meta(Brobygger b)
    {
        var d = new List<string>();
        if (!string.IsNullOrEmpty(b.Hq)) d.Add(b.Hq!);
        if (!string.IsNullOrEmpty(b.Region)) d.Add(b.Region!);
        if (!string.IsNullOrEmpty(b.Telefon)) d.Add(b.Telefon!);
        return d.Count == 0 ? "—" : string.Join(" · ", d);
    }

    private IEnumerable<Brobygger> Filtered => string.IsNullOrWhiteSpace(search)
        ? rows
        : rows.Where(b => (b.Navn ?? "").Contains(search, StringComparison.OrdinalIgnoreCase)
                       || (b.Hq ?? "").Contains(search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        try { rows = await Api.GetBrobyggere(); error = null; }
        catch (Exception e) { error = "Kunne ikke hente: " + e.Message; }
    }

    private async Task Opret()
    {
        try { await Api.CreateBrobygger(form); form = new(); await Load(); }
        catch (Exception e) { error = "Kunne ikke oprette: " + e.Message; }
    }
}

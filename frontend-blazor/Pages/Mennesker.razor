@page "/mennesker"
@inject ApiClient Api
@inject IJSRuntime JS
@inject ScopeState Scope
@implements IDisposable

<div class="page-head">
    <div class="ph-id">
        <h1>Mennesker</h1>
        <p class="ph-sub">@Scoped.Count borgere@(Scope.Aktiv ? " i " + (Scope.Afdeling ?? Scope.Hovedsaede) : "") · @Scoped.Count(m => m.MatchedWith is null && m.Status != "afsluttet") afventer match</p>
    </div>
    <div class="ph-act">
        <button class="ghost" @onclick="Eksport">Eksportér</button>
        <button @onclick="() => visForm = !visForm">@(visForm ? "Luk" : "Nyt menneske")</button>
    </div>
</div>
@if (error is not null) { <div class="status err">@error</div> }

@if (visForm)
{
    <form @onsubmit="Opret">
        <div class="form-sec">Nyt menneske</div>
        @if (dubletter.Any())
        {
            <div class="dublet-advarsel">
                <div class="da-hd"><span class="da-ic">!</span> Muligt dublet — ligner @(dubletter.Count == 1 ? "et" : dubletter.Count) eksisterende</div>
                @foreach (var d in dubletter)
                {
                    <a class="da-rk" href="mennesker/@d.Id">
                        <span><b>@d.Navn</b>@(string.IsNullOrEmpty(d.Telefon) ? "" : " · " + d.Telefon)@(string.IsNullOrEmpty(d.Hq) ? "" : " · " + d.Hq)</span>
                        <span class="two">@d.Grund → åbn</span>
                    </a>
                }
            </div>
        }
        <div><label>Navn *</label><input @bind="form.Navn" @bind:event="oninput" @bind:after="CheckDublet" required /></div>
        <div><label>Alder</label><input type="number" @bind="form.Alder" @bind:after="CheckDublet" /></div>
        <div><label>Telefon</label><input @bind="form.Telefon" @bind:event="oninput" @bind:after="CheckDublet" /></div>
        <OmraadeVaelger Hovedsaeder="hovedsaeder" Hovedsaede="@form.Hq" HovedsaedeChanged="v => form.Hq = v" Afdeling="@form.Afdeling" AfdelingChanged="v => form.Afdeling = v" />
        <div>
            <label>Status</label>
            <select @bind="form.Status">
                <option value="ny">Ny</option>
                <option value="matched">Matched</option>
                <option value="aktiv">Aktiv</option>
                <option value="afsluttet">Afsluttet</option>
                <option value="venteliste">Venteliste</option>
            </select>
        </div>
        <div class="full"><button type="button" class="ghost" @onclick="() => visForm = false">Annullér</button><button type="submit">Opret menneske</button></div>
    </form>
}

<div class="row" style="margin:16px 0"><input class="soeg" placeholder="Søg navn eller hovedsæde…" @bind="search" @bind:event="oninput" /></div>

@if (!Filtered.Any())
{
    <div class="kort muted">Ingen mennesker matcher.</div>
}
else
{
    <div class="rowcards">
        @foreach (var m in Filtered)
        {
            <div class="rowcard">
                <div class="rc-ini">@Initialer(m.Navn)</div>
                <div class="rc-main">
                    <div class="rc-navn">
                        <b><a href="mennesker/@m.Id">@m.Navn</a></b>
                        @if (!string.IsNullOrEmpty(m.Brobygningstype)) { <span class="tmono @BtClass(m.Brobygningstype)">@m.Brobygningstype</span> }
                    </div>
                    <div class="rc-meta">@Meta(m)</div>
                </div>
                <span class="smono @StatusFarve.Klasse(m.Status)">@m.Status</span>
                <div class="rc-act"><a class="btn-lnk" href="mennesker/@m.Id">Åbn</a></div>
            </div>
        }
    </div>
}

<style>
    .dublet-advarsel { grid-column:1/-1; background:var(--warn-tint); border:1px solid #ecd8ab; border-radius:var(--r-md); padding:12px 14px; display:flex; flex-direction:column; gap:8px; }
    .dublet-advarsel .da-hd { font-size:13.5px; font-weight:600; color:var(--warn); display:flex; align-items:center; gap:8px; }
    .dublet-advarsel .da-ic { width:18px; height:18px; flex:0 0 auto; border-radius:50%; background:var(--warn); color:#fff; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700; }
    .dublet-advarsel .da-rk { display:flex; justify-content:space-between; gap:12px; align-items:baseline; padding:8px 10px; background:var(--card); border:1px solid var(--line); border-radius:var(--r-sm); text-decoration:none; color:var(--ink); font-size:13.5px; }
    .dublet-advarsel .da-rk:hover { border-color:var(--line-strong); text-decoration:none; }
</style>

@code {
    private List<Menneske> rows = [];
    private MenneskeCreate form = new();
    private string search = "";
    private bool visForm;
    private string? error;
    private List<DuplikatForslag> dubletter = [];
    private int dubSeq;
    private List<HovedsaedeDto> hovedsaeder = [];

    // Debounced dublet-tjek mens koordinatoren udfylder navn/telefon
    private async Task CheckDublet()
    {
        var mit = ++dubSeq;
        await Task.Delay(300);
        if (mit != dubSeq) return;
        try { dubletter = await Api.MuligeDubletter(form.Navn, form.Telefon, form.Alder); }
        catch { dubletter = []; }
        StateHasChanged();
    }

    private List<Menneske> Scoped => rows.Where(m => Scope.Matcher(m.Hq, m.Afdeling)).ToList();
    private IEnumerable<Menneske> Filtered => Scoped
        .Where(m => string.IsNullOrWhiteSpace(search)
                 || (m.Navn ?? "").Contains(search, StringComparison.OrdinalIgnoreCase)
                 || (m.Hq ?? "").Contains(search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        Scope.OnChange += StateHasChanged;
        try { hovedsaeder = await Api.GetHovedsaeder(); } catch { }
        await Load();
    }
    public void Dispose() => Scope.OnChange -= StateHasChanged;

    private async Task Load()
    {
        try { rows = await Api.GetMennesker(); error = null; }
        catch (Exception e) { error = "Kunne ikke hente — kører backend på localhost:5080? (" + e.Message + ")"; }
    }

    private async Task Opret()
    {
        try { await Api.CreateMenneske(form); form = new(); dubletter = []; visForm = false; await Load(); }
        catch (Exception e) { error = "Kunne ikke oprette: " + e.Message; }
    }

    private async Task Eksport()
    {
        try { var csv = await Api.EksportMennesker(); await JS.InvokeVoidAsync("downloadText", "mennesker.csv", csv); }
        catch (Exception e) { error = "Kunne ikke eksportere: " + e.Message; }
    }

    private static string Initialer(string navn)
    {
        var dele = (navn ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (dele.Length == 0) return "?";
        return dele.Length == 1 ? dele[0][..1].ToUpper() : (dele[0][..1] + dele[^1][..1]).ToUpper();
    }

    private static string Meta(Menneske m)
    {
        var d = new List<string>();
        if (!string.IsNullOrEmpty(m.Hq)) d.Add(m.Hq!);
        if (m.Alder is int a) d.Add($"{a} år");
        if (!string.IsNullOrEmpty(m.Telefon)) d.Add(m.Telefon!);
        return d.Count == 0 ? "—" : string.Join(" · ", d);
    }

    private static string BtClass(string? bt) => (bt ?? "").ToLowerInvariant() switch { "social" => "social", "forening" => "forening", "sundhed" => "sundhed", _ => "" };
}

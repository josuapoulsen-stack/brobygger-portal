@page "/"
@inject ApiClient Api

<div class="hero">
    <h1>Overblik</h1>
    <p class="sub" style="margin:0 0 1.1rem">@Kapitaliser(DateTime.Now.ToString("dddd d. MMMM yyyy"))</p>
</div>
<div class="statrow">
    <a class="statcell" href="mennesker"><span class="sl"><i class="d accent"></i>Mennesker</span><span class="num">@mennesker.Count</span></a>
    <a class="statcell" href="brobyggere"><span class="sl"><i class="d gron"></i>Brobyggere</span><span class="num">@brobyggere.Count</span></a>
    <a class="statcell" href="aftaler"><span class="sl"><i class="d gul"></i>Aktive aftaler</span><span class="num">@Aktive</span></a>
    <span class="statcell"><span class="sl"><i class="d"></i>Ledig kapacitet</span><span class="num">@Ledig</span></span>
</div>
@if (error is not null) { <div class="status err">@error</div> }

<div class="cols">
    <section class="panel">
        <div class="panel-hd"><h3>Kommende aftaler</h3><a href="kalender" class="two">Kalender →</a></div>
        @if (Kommende.Count == 0) { <p class="muted">Ingen kommende aftaler.</p> }
        @foreach (var a in Kommende)
        {
            <a class="rowitem @BtClass(a.Brobygningstype)" href="aftaler/@a.Id">
                <span class="tid">@a.Dato.ToLocalTime().ToString("dd/MM HH:mm")</span>
                <span class="navn">@NavnM(a.MenneskeId)@(string.IsNullOrEmpty(a.Titel) ? "" : " · " + a.Titel)</span>
                <span class="smono @StatusClass(a.Status)">@a.Status</span>
            </a>
        }
    </section>

    <section class="panel">
        <div class="panel-hd"><h3>Afventer bekræftelse</h3><span class="badge2">@Afventer.Count</span></div>
        @if (Afventer.Count == 0) { <p class="muted">Alt bekræftet 🎉</p> }
        @foreach (var a in Afventer)
        {
            <div class="rowitem gul">
                <span class="navn"><a href="aftaler/@a.Id">@NavnM(a.MenneskeId)</a> <span class="two">@a.Dato.ToLocalTime().ToString("dd/MM")</span></span>
                <button class="mini" @onclick="() => Bekraeft(a.Id)">Bekræft</button>
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-hd"><h3>Skal matches</h3><span class="badge2">@Umatchede.Count</span></div>
        @if (Umatchede.Count == 0) { <p class="muted">Alle er matchet.</p> }
        @foreach (var m in Umatchede)
        {
            <a class="rowitem" href="mennesker/@m.Id">
                <span class="navn">@m.Navn</span>
                <span class="two">@(m.Hq ?? "—")</span>
                <span class="smono @StatusClass2(m.Status)">@m.Status</span>
            </a>
        }
    </section>
</div>

<section class="res">
    <div class="res-hd"><span class="eyebrow">Ressourcer</span></div>
    <div class="res-list">
        @foreach (var r in Ressourcer)
        {
            <a class="res-item" href="@r.Href" target="_blank" rel="noopener">
                <span class="res-ic">@((MarkupString)r.Ikon)</span>
                <span class="res-tx"><b>@r.Titel</b><span class="two">@r.Under</span></span>
                <span class="res-pil">→</span>
            </a>
        }
    </div>
</section>

<style>
    .hero h1 { margin:0 0 .2rem; }
    .cols { display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:1rem; align-items:start; margin-top:1.4rem; }
    .panel { background:var(--card); border:1px solid var(--line-strong); border-radius:14px; padding:1rem 1.1rem; }
    .panel-hd { display:flex; justify-content:space-between; align-items:center; margin-bottom:.7rem; }
    .panel-hd h3 { margin:0; font-size:1.02rem; }
    .badge2 { font-family:var(--mono); font-size:.72rem; background:var(--sand); color:var(--soft); border-radius:999px; padding:.05rem .5rem; }
    .rowitem { display:flex; align-items:center; gap:.6rem; padding:.5rem .55rem; border-radius:8px; border-left:3px solid var(--line-strong); background:var(--surface); margin-bottom:.4rem; text-decoration:none; color:var(--ink); font-size:.88rem; }
    a.rowitem:hover { background:var(--accent-wash); }
    .rowitem.social { border-left-color:#C04F6E; } .rowitem.forening { border-left-color:#2C8A5E; } .rowitem.sundhed { border-left-color:#2E6E9E; }
    .rowitem.gul { border-left-color:var(--warn); }
    .rowitem .tid { font-family:var(--mono); font-size:.76rem; color:var(--soft); flex:0 0 auto; }
    .rowitem .navn { flex:1 1 auto; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

    .res { margin-top:1.4rem; }
    .eyebrow { font-family:var(--mono); font-size:.64rem; text-transform:uppercase; letter-spacing:.12em; color:var(--muted); }
    .res-list { margin-top:.55rem; background:var(--card); border:1px solid var(--line-strong); border-radius:14px; overflow:hidden; }
    .res-item { display:flex; align-items:center; gap:.85rem; padding:.75rem 1rem; border-bottom:1px solid var(--line); text-decoration:none; color:var(--ink); }
    .res-item:last-child { border-bottom:none; }
    .res-item:hover { background:var(--surface); }
    .res-ic { width:34px; height:34px; flex:0 0 auto; display:flex; align-items:center; justify-content:center; border:1px solid var(--line-strong); border-radius:9px; color:var(--accent); background:var(--accent-wash); }
    .res-ic svg { width:17px; height:17px; }
    .res-tx { flex:1 1 auto; display:flex; flex-direction:column; gap:.05rem; }
    .res-tx b { font-size:.92rem; font-weight:600; }
    .res-pil { color:var(--muted); font-family:var(--mono); }
    .res-item:hover .res-pil { color:var(--accent); }
</style>

@code {
    private List<Menneske> mennesker = [];
    private List<Brobygger> brobyggere = [];
    private List<Aftale> aftaler = [];
    private string? error;

    private int Aktive => aftaler.Count(a => a.Status is "planlagt" or "pending" or "confirmed");
    private int Ledig => brobyggere.Sum(b => Math.Max(0, b.MaxActive - b.Active));
    private List<Aftale> Kommende => aftaler.Where(a => a.Dato.ToLocalTime() >= DateTime.Now.AddHours(-12) && a.Status is not ("aflyst" or "afslaaet" or "gennemfoert" or "brudt")).OrderBy(a => a.Dato).Take(7).ToList();
    private List<Aftale> Afventer => aftaler.Where(a => a.Status == "pending").OrderBy(a => a.Dato).Take(8).ToList();
    private List<Menneske> Umatchede => mennesker.Where(m => m.MatchedWith is null && m.Status is not ("afsluttet")).Take(8).ToList();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        try
        {
            mennesker = await Api.GetMennesker();
            brobyggere = await Api.GetBrobyggere();
            aftaler = await Api.GetAftaler();
            error = null;
        }
        catch (Exception e) { error = "Kunne ikke hente — kører backend på localhost:5080? (" + e.Message + ")"; }
    }

    private async Task Bekraeft(Guid id)
    {
        try { await Api.SetAftaleStatus(id, "confirmed"); await Load(); }
        catch (Exception e) { error = "Kunne ikke bekræfte: " + e.Message; }
    }

    private record Res(string Titel, string Under, string Href, string Ikon);
    private static readonly List<Res> Ressourcer =
    [
        new("Guides", "Sådan brobygger du — trin for trin", "https://socialsundhed.org",
            "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8'><path d='M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z'/><path d='M4 5.5v15'/></svg>"),
        new("Manualer", "Retningslinjer, samtykke og GDPR", "https://socialsundhed.org",
            "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8'><path d='M6 2h9l5 5v15H6z'/><path d='M14 2v6h6'/><path d='M9 13h7M9 17h7'/></svg>"),
        new("Webinarer", "Optagelser og kommende oplæg", "https://socialsundhed.org",
            "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8'><rect x='2' y='5' width='15' height='14' rx='2'/><path d='M17 10l5-3v10l-5-3z'/></svg>"),
        new("Support", "Kontakt koordinator eller IT", "mailto:kontakt@socialsundhed.org",
            "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8'><path d='M21 11.5a8.4 8.4 0 0 1-9 8.4L3 21l1.1-4.5A8.4 8.4 0 1 1 21 11.5z'/></svg>"),
    ];

    private static string Kapitaliser(string s) => string.IsNullOrEmpty(s) ? s : char.ToUpper(s[0]) + s[1..];

    private string NavnM(Guid id) => mennesker.FirstOrDefault(x => x.Id == id)?.Navn ?? "—";
    private static string BtClass(string? bt) => (bt ?? "").ToLowerInvariant() switch { "social" => "social", "forening" => "forening", "sundhed" => "sundhed", _ => "" };
    private static string StatusClass(string s) => s switch { "confirmed" => "gron", "pending" => "gul", "aflyst" or "afslaaet" or "brudt" => "graa", _ => "" };
    private static string StatusClass2(string s) => s switch { "matched" or "aktiv" => "gron", "venteliste" => "gul", _ => "" };
}

@page "/statistik"
@inject ApiClient Api

<h1>Statistik</h1>
<p class="sub">Overblik og effekt.</p>
@if (error is not null) { <div class="status err">@error</div> }

@if (s is null)
{
    <p class="muted">Henter…</p>
}
else
{
    <div class="tiles">
        <div class="tile"><div class="num">@s.AntalMennesker</div><div class="lbl">Mennesker</div></div>
        <div class="tile"><div class="num">@s.AntalBrobyggere</div><div class="lbl">Brobyggere</div></div>
        <div class="tile"><div class="num">@s.LedigKapacitet</div><div class="lbl">Ledig kapacitet</div></div>
        <div class="tile"><div class="num">@s.AntalMaalinger</div><div class="lbl">Trivselsmålinger</div></div>
        <div class="tile"><div class="num">@(s.Gennemfoerselsrate is double r ? $"{r}%" : "—")</div><div class="lbl">Gennemførselsrate</div></div>
    </div>

    <div class="card">
        <h3>Aftaler pr. måned</h3>
        @if (s.AftalerPrMaaned.Count == 0) { <p class="muted">Ingen data.</p> }
        @foreach (var d in s.AftalerPrMaaned)
        {
            <div class="bar-row"><span class="k">@d.Navn</span><span class="b" style="width:@Bredde(d.Antal, s.AftalerPrMaaned)px"></span><span class="n">@d.Antal</span></div>
        }
    </div>

    <div class="card">
        <h3>Trivselsudvikling (kombineret · 5–25 · højere = bedre)</h3>
        <div class="row">
            <div class="stat"><span class="num2">@(s.TrivselBaselineGns?.ToString() ?? "—")</span><span class="lbl">Baseline (gns.)</span></div>
            <div class="stat"><span class="num2">@(s.TrivselOpfoelgningGns?.ToString() ?? "—")</span><span class="lbl">Opfølgning (gns.)</span></div>
            @if (s.TrivselBaselineGns is double b && s.TrivselOpfoelgningGns is double o)
            {
                <div class="stat"><span class="num2" style="color:@((o - b) >= 0 ? "var(--good)" : "var(--crit)")">@((o - b) >= 0 ? "+" : "")@Math.Round(o - b, 1)</span><span class="lbl">Ændring</span></div>
            }
        </div>
    </div>

    <div class="grid2">
        <div class="card">
            <h3>Mennesker pr. status</h3>
            @if (s.MenneskerPerStatus.Count == 0) { <p class="muted">Ingen data.</p> }
            @foreach (var d in s.MenneskerPerStatus)
            {
                <div class="bar-row"><span class="k">@d.Navn</span><span class="b" style="width:@Bredde(d.Antal, s.MenneskerPerStatus)px"></span><span class="n">@d.Antal</span></div>
            }
        </div>
        <div class="card">
            <h3>Aftaler pr. status</h3>
            @if (s.AftalerPerStatus.Count == 0) { <p class="muted">Ingen data.</p> }
            @foreach (var d in s.AftalerPerStatus)
            {
                <div class="bar-row"><span class="k">@d.Navn</span><span class="b @StatusFarve.Klasse(d.Navn)" style="width:@Bredde(d.Antal, s.AftalerPerStatus)px"></span><span class="n">@d.Antal</span></div>
            }
        </div>
        <div class="card">
            <h3>Mennesker pr. hovedsæde</h3>
            @if (s.MenneskerPerHovedsaede.Count == 0) { <p class="muted">Ingen data.</p> }
            @foreach (var d in s.MenneskerPerHovedsaede)
            {
                <div class="bar-row"><span class="k">@d.Navn</span><span class="b" style="width:@Bredde(d.Antal, s.MenneskerPerHovedsaede)px"></span><span class="n">@d.Antal</span></div>
            }
        </div>
    </div>
}

<style>
    .tiles { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:1rem; }
    .tile { background:var(--card); border:1px solid var(--line-strong); border-radius:12px; padding:1rem 1.1rem; }
    .num { font-size:1.9rem; line-height:1; color:var(--ink); }
    .lbl { color:var(--soft); font-family:var(--mono); font-size:.62rem; text-transform:uppercase; letter-spacing:.06em; margin-top:.35rem; }
    .card { background:var(--card); border:1px solid var(--line-strong); border-radius:12px; padding:1rem 1.1rem; margin-top:1rem; }
    .card h3 { margin:0 0 .7rem; font-size:.98rem; }
    .grid2 { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:1rem; }
    .stat { display:flex; flex-direction:column; margin-right:1.8rem; }
    .num2 { font-family:var(--mono); font-size:1.5rem; font-weight:700; letter-spacing:-.02em; color:var(--ink); }
    .bar-row { display:flex; align-items:center; gap:.7rem; margin:.3rem 0; font-size:.85rem; }
    .bar-row .k { width:130px; color:var(--soft); }
    .bar-row .b { height:12px; background:var(--accent); border-radius:3px; min-width:6px; }
    .bar-row .b.gron { background:var(--good); } .bar-row .b.gul { background:var(--warn); } .bar-row .b.graa { background:var(--line-strong); }
    .bar-row .n { font-family:var(--mono); font-weight:600; font-variant-numeric:tabular-nums; }
</style>

@code {
    private StatistikData? s;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try { s = await Api.GetStatistik(); }
        catch (Exception e) { error = "Kunne ikke hente: " + e.Message; }
    }

    private static int Bredde(int antal, List<Optael> alle)
    {
        var max = alle.Count == 0 ? 1 : alle.Max(x => x.Antal);
        return Math.Max(6, antal * 140 / Math.Max(1, max));
    }
}

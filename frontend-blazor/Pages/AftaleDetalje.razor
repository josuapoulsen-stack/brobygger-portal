@page "/aftaler/{Id:guid}"
@inject ApiClient Api

@if (error is not null) { <div class="status err">@error</div> }

@if (a is null)
{
    <p class="muted">Henter…</p>
}
else
{
    <p class="sub"><a href="aftaler">← Aftaler</a></p>
    <h1>Aftale</h1>

    <div class="card">
        <dl>
            @if (!string.IsNullOrEmpty(a.Titel)) { <dt>Titel</dt><dd>@a.Titel</dd> }
            @if (!string.IsNullOrEmpty(a.Programtype) || !string.IsNullOrEmpty(a.Indsatstype))
            {
                <dt>Indsats</dt>
                <dd>
                    @if (!string.IsNullOrEmpty(a.Programtype)) { <span class="chip-code">@a.Programtype</span> }
                    @if (!string.IsNullOrEmpty(a.Indsatstype)) { <span class="chip-code">@a.Indsatstype</span> }
                    @if (!string.IsNullOrEmpty(a.Brobygningstype)) { <span class="pill @BtClass(a.Brobygningstype)">@a.Brobygningstype</span> }
                </dd>
            }
            @if (a.GentagelserAntal is int g && g > 0) { <dt>Gentagelser</dt><dd>@g gange, @a.DageImellem dage imellem</dd> }
            <dt>Menneske</dt><dd><a href="mennesker/@a.MenneskeId">@(menneske?.Navn ?? "—")</a></dd>
            <dt>Brobygger</dt><dd>@if (a.BrobyggerId is Guid bid2) { <a href="brobyggere/@bid2">@(brobygger?.Navn ?? "—")</a> } else { <span class="muted">Ikke tildelt</span> }</dd>
            <dt>Start</dt><dd>@a.Dato.ToLocalTime().ToString("dd. MMM yyyy HH:mm")</dd>
            @if (a.Slut is DateTimeOffset sl) { <dt>Slut</dt><dd>@sl.ToLocalTime().ToString("dd. MMM yyyy HH:mm")</dd> }
            <dt>Type</dt><dd>@a.Type</dd>
            <dt>Sted</dt><dd>@(a.Sted ?? "—")</dd>
            <dt>Brobygningstype</dt><dd>@(a.Brobygningstype ?? "—")</dd>
            <dt>Status</dt><dd><span class="pill @StatusClass(a.Status)">@a.Status</span></dd>
            <dt>Oprettet</dt><dd>@a.CreatedAt.ToLocalTime().ToString("dd. MMM yyyy HH:mm")</dd>
            <dt>Efterspurgt</dt><dd>@a.EfterspurgtAt.ToLocalTime().ToString("dd. MMM yyyy")</dd>
            <dt>Brobygger tildelt</dt><dd>@(a.BrobyggerTildeltAt is null ? "—" : a.BrobyggerTildeltAt.Value.ToLocalTime().ToString("dd. MMM yyyy HH:mm"))</dd>
            <dt>Bekræftet</dt><dd>@(a.BekraeftetAt is null ? "—" : a.BekraeftetAt.Value.ToLocalTime().ToString("dd. MMM yyyy"))</dd>
        </dl>
    </div>

    <div class="card">
        <h3>Redigér aftale</h3>
        <div class="row">
            <select @bind="rediger.BrobyggerId">
                <option value="">— ingen brobygger —</option>
                @foreach (var bb in brobyggere) { <option value="@bb.Id">@bb.Navn</option> }
            </select>
            <input type="datetime-local" @bind="redigerDato" />
            <input placeholder="Sted" @bind="rediger.Sted" />
            <select @bind="rediger.Type">
                <option value="moede">Møde</option>
                <option value="aktivitet">Aktivitet</option>
                <option value="telefonopkald">Telefonopkald</option>
                <option value="online">Online</option>
            </select>
            <select @bind="rediger.Brobygningstype">
                <option value="">—</option>
                <option value="Social">Social</option>
                <option value="Forening">Forening</option>
                <option value="Sundhed">Sundhed</option>
            </select>
            <button class="mini" @onclick="GemAftale">Gem</button>
        </div>
    </div>

    <div class="card">
        <h3>Registrér udfald</h3>
        @if (a.Udfald is not null) { <p class="two">Registreret: <b>@a.Udfald</b> @(a.VarighedMin is int v ? $"· {v} min" : "")</p> }
        <div class="row">
            <select @bind="udfald.Udfald">
                <option value="gennemfoert">Gennemført</option>
                <option value="afbud">Afbud</option>
                <option value="ikke-modt">Ikke mødt</option>
            </select>
            <input type="number" placeholder="Varighed (min)" @bind="udfald.VarighedMin" />
            <input placeholder="Note" @bind="udfald.LogNote" />
            <button class="mini" @onclick="GemUdfald">Gem</button>
        </div>
    </div>

    <div class="card">
        <h3>Beskeder</h3>
        <div class="traad">
            @foreach (var b in beskeder)
            {
                <div class="besked">
                    <div class="meta">@b.Afsender · @b.Tidspunkt.ToLocalTime().ToString("dd. MMM yyyy HH:mm")</div>
                    <div>@b.Tekst</div>
                </div>
            }
            @if (beskeder.Count == 0) { <p class="muted">Ingen beskeder endnu.</p> }
        </div>
        <div class="row">
            <textarea @bind="nyBesked.Tekst" rows="2" placeholder="Skriv en besked…"></textarea>
            <button class="mini" @onclick="Send">Send</button>
        </div>
        <p class="two">Brobyggeren kan se aftalen og beskederne, når adgangsstyring (Entra) er live.</p>
    </div>
}

<style>
    .card { background:var(--card); border:1px solid var(--line); border-radius:12px; padding:1rem 1.2rem; margin-top:1rem; max-width:640px; }
    .card h3 { margin:0 0 .6rem; font-size:1rem; }
    dl { display:grid; grid-template-columns:auto 1fr; gap:.2rem .8rem; margin:0; font-size:.9rem; }
    dt { color:var(--soft); }
    .traad { display:flex; flex-direction:column; gap:.6rem; margin-bottom:.8rem; }
    .besked { background:var(--bg); border:1px solid var(--line); border-radius:8px; padding:.5rem .7rem; font-size:.9rem; }
    .besked .meta { color:var(--soft); font-size:.75rem; margin-bottom:.15rem; }
</style>

@code {
    [Parameter] public Guid Id { get; set; }

    private Aftale? a;
    private Menneske? menneske;
    private Brobygger? brobygger;
    private List<Brobygger> brobyggere = [];
    private List<Besked> beskeder = [];
    private BeskedCreate nyBesked = new();
    private DateTime redigerDato;
    private AftaleUpdate rediger = new();
    private AftaleLog udfald = new();
    private string? error;

    protected override async Task OnParametersSetAsync() => await Load();

    private async Task Load()
    {
        try
        {
            a = await Api.GetAftale(Id);
            if (a is not null)
            {
                menneske = await Api.GetMenneske(a.MenneskeId);
                brobygger = a.BrobyggerId is Guid bid ? await Api.GetBrobygger(bid) : null;
                beskeder = await Api.GetBeskeder(Id);
                brobyggere = await Api.GetBrobyggere();
                redigerDato = a.Dato.ToLocalTime().DateTime;
                rediger = new AftaleUpdate { BrobyggerId = a.BrobyggerId, Sted = a.Sted, Type = a.Type, Brobygningstype = a.Brobygningstype };
            }
            error = null;
        }
        catch (Exception e) { error = "Kunne ikke hente: " + e.Message; }
    }

    private static string BtClass(string? bt) => (bt ?? "").ToLowerInvariant() switch { "social" => "social", "forening" => "forening", "sundhed" => "sundhed", _ => "" };
    private static string StatusClass(string s) => s switch { "confirmed" => "gron", "pending" => "gul", "aflyst" or "afslaaet" or "brudt" => "graa", _ => "" };

    private async Task GemAftale()
    {
        rediger.Dato = DateTime.SpecifyKind(redigerDato, DateTimeKind.Local).ToUniversalTime();
        try { await Api.UpdateAftale(Id, rediger); await Load(); }
        catch (Exception e) { error = "Kunne ikke gemme: " + e.Message; }
    }

    private async Task GemUdfald()
    {
        try { await Api.LogUdfald(Id, udfald); await Load(); }
        catch (Exception e) { error = "Kunne ikke gemme udfald: " + e.Message; }
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(nyBesked.Tekst)) return;
        try { await Api.CreateBesked(Id, nyBesked); nyBesked = new(); beskeder = await Api.GetBeskeder(Id); }
        catch (Exception e) { error = "Kunne ikke sende: " + e.Message; }
    }
}

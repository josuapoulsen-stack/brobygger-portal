@page "/matching"
@inject ApiClient Api

<div class="page-head">
    <div class="ph-id">
        <h1>Matching</h1>
        <p class="ph-sub">Vælg en person til venstre — systemet foreslår passende brobyggere efter kapacitet, hovedsæde, behov og sprog.</p>
    </div>
    <div class="ph-act"><span class="smono gul">@Umatchede.Count venter</span></div>
</div>
@if (error is not null) { <div class="status err">@error</div> }

<div class="match-wrap">
    <aside class="match-liste">
        @if (Umatchede.Count == 0) { <p class="muted" style="padding:.8rem">Alle er matchet 🎉</p> }
        @foreach (var m in Umatchede)
        {
            <button class="mperson @(valgt?.Id == m.Id ? "aktiv" : "")" @onclick="() => Vaelg(m)">
                <span class="mp-navn">@m.Navn</span>
                <span class="mp-meta">
                    <span class="two">@(m.Hq ?? "—")</span>
                    @if (!string.IsNullOrEmpty(m.Brobygningstype)) { <span class="tmono @BtClass(m.Brobygningstype)">@m.Brobygningstype</span> }
                </span>
            </button>
        }
    </aside>

    <section class="match-detalje">
        @if (valgt is null)
        {
            <div class="tomvalg">
                <div class="tomvalg-ic">@((MarkupString)MatchIkon)</div>
                <p class="muted">Vælg en person for at se forslag.</p>
            </div>
        }
        else
        {
            <div class="md-hd">
                <div>
                    <h3 style="margin:0"><a href="mennesker/@valgt.Id">@valgt.Navn</a></h3>
                    <span class="two">
                        @(valgt.Hq ?? "—")
                        @if (valgt.Sprog is { Count: > 0 }) { <text> · @string.Join(", ", valgt.Sprog)</text> }
                        @if (valgt.Typer is { Count: > 0 }) { <text> · @string.Join(", ", valgt.Typer)</text> }
                    </span>
                </div>
            </div>

            @if (henter) { <p class="muted">Henter forslag…</p> }
            else if (forslag.Count == 0) { <p class="muted">Ingen aktive brobyggere med kapacitet lige nu.</p> }
            else
            {
                <div class="fkort-liste">
                    @foreach (var f in forslag)
                    {
                        var fuld = f.Active >= f.MaxActive;
                        <div class="fkort @(fuld ? "fuld" : "")">
                            <div class="fk-top">
                                <div>
                                    <a href="brobyggere/@f.Id" class="fk-navn">@f.Navn</a>
                                    <div class="two">@(f.Hq ?? "—") · kapacitet @f.Active/@f.MaxActive</div>
                                </div>
                                <div class="fk-score" title="Matchscore">
                                    <span class="num">@f.Score</span>
                                    <span class="fk-score-l">score</span>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(f.Begrundelse))
                            {
                                <div class="fk-grunde">
                                    @foreach (var g in f.Begrundelse.Split(" · ", StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="fk-grund @(g == "fuld" ? "neg" : "")">@g</span>
                                    }
                                </div>
                            }
                            <div class="fk-bund">
                                <button class="mini" disabled="@fuld" @onclick="() => MatchMed(f.Id)">@(fuld ? "Ingen kapacitet" : "Match")</button>
                            </div>
                        </div>
                    }
                </div>

                <div class="manuel">
                    <span class="two">Eller vælg manuelt:</span>
                    <select @bind="manueltValg">
                        <option value="@Guid.Empty">— vælg brobygger —</option>
                        @foreach (var b in brobyggere.OrderBy(x => x.Navn)) { <option value="@b.Id">@b.Navn (@b.Active/@b.MaxActive)</option> }
                    </select>
                    <button class="mini ghost" @onclick="MatchManuelt" disabled="@(manueltValg == Guid.Empty)">Match</button>
                </div>
            }
        }
    </section>
</div>

<style>
    .match-wrap { display:grid; grid-template-columns:280px 1fr; gap:1rem; align-items:start; }
    .match-liste { background:var(--card); border:1px solid var(--line-strong); border-radius:12px; overflow:hidden; max-height:72vh; overflow-y:auto; }
    .mperson { display:flex; flex-direction:column; align-items:flex-start; gap:.25rem; width:100%; text-align:left; background:transparent; color:var(--ink); border:none; border-bottom:1px solid var(--line); border-radius:0; padding:.65rem .8rem; cursor:pointer; font-weight:400; }
    .mperson:last-child { border-bottom:none; }
    .mperson:hover { background:var(--surface); }
    .mperson.aktiv { background:var(--accent-wash); border-left:3px solid var(--accent); padding-left:calc(.8rem - 3px); }
    .mp-navn { font-weight:600; font-size:.92rem; }
    .mp-meta { display:flex; gap:.5rem; align-items:center; }
    .match-detalje { background:var(--card); border:1px solid var(--line-strong); border-radius:12px; padding:1.1rem 1.2rem; min-height:200px; }
    .tomvalg { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:.6rem; padding:2.5rem 1rem; text-align:center; }
    .tomvalg-ic { color:var(--line-strong); }
    .tomvalg-ic svg { width:44px; height:44px; }
    .md-hd { margin-bottom:1rem; padding-bottom:.7rem; border-bottom:1px solid var(--line); }
    .fkort-liste { display:flex; flex-direction:column; gap:.7rem; }
    .fkort { border:1px solid var(--line-strong); border-radius:10px; padding:.8rem .9rem; }
    .fkort.fuld { opacity:.6; }
    .fk-top { display:flex; justify-content:space-between; align-items:flex-start; gap:1rem; }
    .fk-navn { font-weight:700; font-size:.98rem; text-decoration:none; color:var(--ink); }
    .fk-navn:hover { color:var(--accent-deep); }
    .fk-score { display:flex; flex-direction:column; align-items:center; line-height:1; flex:0 0 auto; }
    .fk-score .num { font-size:1.5rem; color:var(--accent); }
    .fk-score-l { font-family:var(--mono); font-size:.55rem; text-transform:uppercase; letter-spacing:.08em; color:var(--muted); margin-top:.2rem; }
    .fk-grunde { display:flex; flex-wrap:wrap; gap:.35rem; margin:.6rem 0 .1rem; }
    .fk-grund { font-family:var(--mono); font-size:.66rem; background:var(--good-tint); color:var(--good); padding:.12rem .45rem; border-radius:5px; }
    .fk-grund.neg { background:var(--crit-tint); color:var(--crit); }
    .fk-bund { display:flex; justify-content:flex-end; margin-top:.6rem; }
    .manuel { display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; margin-top:1.1rem; padding-top:.8rem; border-top:1px solid var(--line); }
    .manuel select { width:auto; min-width:200px; }
    @@media (max-width:760px){ .match-wrap { grid-template-columns:1fr; } .match-liste { max-height:none; } }
</style>

@code {
    private List<Menneske> mennesker = [];
    private List<Brobygger> brobyggere = [];
    private List<MatchForslag> forslag = [];
    private Menneske? valgt;
    private Guid manueltValg = Guid.Empty;
    private bool henter;
    private string? error;

    private List<Menneske> Umatchede => mennesker
        .Where(m => m.MatchedWith is null && m.Status is not "afsluttet")
        .OrderBy(m => m.Navn).ToList();

    private const string MatchIkon =
        "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.6'><circle cx='7.5' cy='7.5' r='3'/><circle cx='16.5' cy='7.5' r='3'/><path d='M2.5 19c0-3.3 2.2-5.5 5-5.5s5 2.2 5 5.5'/><path d='M11.5 19c0-3.3 2.2-5.5 5-5.5s5 2.2 5 5.5'/></svg>";

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        try
        {
            mennesker = await Api.GetMennesker();
            brobyggere = await Api.GetBrobyggere();
            error = null;
            // Behold valg hvis stadig umatchet, ellers ryd
            if (valgt is not null && !Umatchede.Any(m => m.Id == valgt.Id)) { valgt = null; forslag = []; }
        }
        catch (Exception e) { error = "Kunne ikke hente: " + e.Message; }
    }

    private async Task Vaelg(Menneske m)
    {
        valgt = m; manueltValg = Guid.Empty; forslag = []; henter = true;
        try { forslag = await Api.GetMatchForslag(m.Id); }
        catch (Exception e) { error = "Kunne ikke hente forslag: " + e.Message; }
        finally { henter = false; }
    }

    private async Task MatchMed(Guid brobyggerId)
    {
        try { await Api.Match(valgt!.Id, brobyggerId); await Load(); }
        catch (Exception e) { error = "Kunne ikke matche: " + e.Message; }
    }

    private async Task MatchManuelt()
    {
        if (manueltValg == Guid.Empty) return;
        await MatchMed(manueltValg);
    }

    private static string BtClass(string? bt) => (bt ?? "").ToLowerInvariant() switch { "social" => "social", "forening" => "forening", "sundhed" => "sundhed", _ => "" };
}

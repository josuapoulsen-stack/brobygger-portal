@page "/aftaler"
@inject ApiClient Api
@inject IJSRuntime JS

<div style="display:flex;justify-content:space-between;align-items:center">
    <h1>Aftaler</h1>
    <button class="mini ghost" @onclick="Eksport">Eksportér CSV</button>
</div>
<p class="sub">Efterspørg en brobygning nu — bekræft den når den er på plads (dage/uger senere).</p>
@if (error is not null) { <div class="status err">@error</div> }

<table>
    <thead><tr><th>Menneske</th><th>Brobygger</th><th>Dato</th><th>Status</th><th>Efterspurgt</th><th>Bekræftet</th><th></th></tr></thead>
    <tbody>
        @if (rows.Count == 0) { <tr><td colspan="7" class="muted">Ingen aftaler endnu.</td></tr> }
        @foreach (var a in rows)
        {
            <tr>
                <td>
                    <a href="mennesker/@a.MenneskeId">@NavnM(a.MenneskeId)</a>
                    @if (!string.IsNullOrEmpty(a.Titel)) { <div class="two">@a.Titel</div> }
                    <div style="margin-top:.2rem">
                        @if (!string.IsNullOrEmpty(a.Brobygningstype)) { <span class="tmono @BtClass(a.Brobygningstype)">@a.Brobygningstype</span> }
                        @if (!string.IsNullOrEmpty(a.Programtype)) { <span class="chip-code">@a.Programtype</span> }
                        @if (!string.IsNullOrEmpty(a.Indsatstype)) { <span class="chip-code">@a.Indsatstype</span> }
                    </div>
                </td>
                <td>
                    @if (a.BrobyggerId is Guid bid) { <a href="brobyggere/@bid">@NavnB(bid)</a> }
                    else { <span class="muted">Ikke tildelt</span> }
                </td>
                <td><a href="aftaler/@a.Id">@a.Dato.ToLocalTime().ToString("dd. MMM yyyy")</a></td>
                <td><span class="smono @Pill(a.Status)">@a.Status</span></td>
                <td class="two">@a.EfterspurgtAt.ToLocalTime().ToString("dd. MMM yyyy")</td>
                <td class="two">@(a.BekraeftetAt is null ? "—" : a.BekraeftetAt.Value.ToLocalTime().ToString("dd. MMM yyyy"))</td>
                <td class="handling">
                    @if (a.Status is "pending" or "planlagt")
                    {
                        <button class="mini" @onclick='() => Skift(a.Id, "confirmed")'>Bekræft</button>
                    }
                    @if (a.Status == "confirmed")
                    {
                        <button class="mini" @onclick='() => Skift(a.Id, "gennemfoert")'>Gennemført</button>
                    }
                    @if (a.Status is not ("aflyst" or "gennemfoert" or "afslaaet" or "brudt"))
                    {
                        <button class="mini ghost" @onclick='() => Skift(a.Id, "aflyst")'>Aflys</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<form @onsubmit="Opret">
    <div style="grid-column:1/-1"><label>Titel</label><input @bind="form.Titel" placeholder="fx Nusrat til øjenlæge" /></div>
    <div>
        <label>Menneske *</label>
        <select @bind="form.MenneskeId">
            @foreach (var m in mennesker) { <option value="@m.Id">@m.Navn</option> }
        </select>
    </div>
    <div>
        <label>Brobygger</label>
        <select @bind="form.BrobyggerId">
            <option value="">— vælg senere —</option>
            @foreach (var b in brobyggere) { <option value="@b.Id">@b.Navn</option> }
        </select>
    </div>
    <div><label>Start *</label><input type="datetime-local" @bind="dato" /></div>
    <div><label>Slut</label><input type="datetime-local" @bind="slut" /></div>
    <div style="grid-column:1/-1">
        <label>Sted (sygehus/afdeling — autoudfyld fra SOR)</label>
        <StedFelt Vaerdi="form.Sted" VaerdiChanged="v => form.Sted = v" OnValgt="StedValgt" />
    </div>
    <div>
        <label>Brobygningstype</label>
        <select @bind="form.Brobygningstype">
            <option value="">—</option>
            <option value="Social">Social</option>
            <option value="Forening">Forening</option>
            <option value="Sundhed">Sundhed</option>
        </select>
    </div>
    <div>
        <label>Henvender</label>
        <select @bind="form.Henvender">
            <option value="">—</option>
            @foreach (var s in henvenderListe) { <option value="@s.Vaerdi">@s.Vaerdi</option> }
        </select>
    </div>
    <div>
        <label>Modtager</label>
        <select @bind="form.Modtager">
            <option value="">—</option>
            @foreach (var s in modtagerListe) { <option value="@s.Vaerdi">@s.Vaerdi</option> }
        </select>
    </div>
    <div><label>Henvender (konkret)</label><input @bind="form.HenvenderKonkret" /></div>
    <div><label>Modtager (konkret)</label><input @bind="form.ModtagerKonkret" /></div>
    <div>
        <label>Programtype</label>
        <input list="dl-programtype" @bind="form.Programtype" placeholder="fx SBB" />
        <datalist id="dl-programtype">@foreach (var s in programtypeListe) { <option value="@s.Vaerdi" /> }</datalist>
    </div>
    <div>
        <label>Indsatstype</label>
        <input list="dl-indsatstype" @bind="form.Indsatstype" placeholder="fx IDAB" />
        <datalist id="dl-indsatstype">@foreach (var s in indsatstypeListe) { <option value="@s.Vaerdi" /> }</datalist>
    </div>
    <div><label>Gentagelser (antal)</label><input type="number" @bind="form.GentagelserAntal" /></div>
    <div><label>Dage imellem</label><input type="number" @bind="form.DageImellem" /></div>
    <div>
        <label>Type</label>
        <select @bind="form.Type">
            <option value="moede">Møde</option>
            <option value="aktivitet">Aktivitet</option>
            <option value="telefonopkald">Telefonopkald</option>
            <option value="online">Online</option>
        </select>
    </div>
    <div>
        <label>Skabelon (besked)</label>
        <select @onchange="BrugSkabelon">
            <option value="">— vælg skabelon —</option>
            @foreach (var sk in skabeloner) { <option value="@sk.Id">@sk.Navn</option> }
        </select>
    </div>
    <div style="grid-column:1/-1">
        <label>Besked til aftalen</label>
        <textarea @bind="form.Beskrivelse" rows="3"></textarea>
        <p class="two">Pladsholdere: {menneske}, {brobygger}, {sted}, {dato} — udfyldes når du vælger skabelonen.</p>
    </div>
    <div class="full"><button type="submit">Efterspørg aftale</button></div>
</form>

@code {
    private List<Aftale> rows = [];
    private List<Menneske> mennesker = [];
    private List<Brobygger> brobyggere = [];
    private List<Skabelon> skabeloner = [];
    private List<StamdataVaerdi> henvenderListe = [];
    private List<StamdataVaerdi> modtagerListe = [];
    private List<StamdataVaerdi> programtypeListe = [];
    private List<StamdataVaerdi> indsatstypeListe = [];
    private AftaleCreate form = new();
    private DateTime dato = DateTime.Now;
    private DateTime? slut;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            mennesker = await Api.GetMennesker();
            brobyggere = await Api.GetBrobyggere();
            skabeloner = await Api.GetSkabeloner();
            henvenderListe = await Api.GetStamdata("henvender");
            modtagerListe = await Api.GetStamdata("modtager");
            programtypeListe = await Api.GetStamdata("programtype");
            indsatstypeListe = await Api.GetStamdata("indsatstype");
            if (mennesker.Count > 0) form.MenneskeId = mennesker[0].Id;
            await Load();
        }
        catch (Exception e) { error = "Kunne ikke hente: " + e.Message; }
    }

    private async Task Load()
    {
        try { rows = await Api.GetAftaler(); error = null; }
        catch (Exception e) { error = "Kunne ikke hente: " + e.Message; }
    }

    private async Task Opret()
    {
        try
        {
            form.Dato = DateTime.SpecifyKind(dato, DateTimeKind.Local).ToUniversalTime();
            form.Slut = slut is DateTime s ? DateTime.SpecifyKind(s, DateTimeKind.Local).ToUniversalTime() : null;
            await Api.CreateAftale(form); slut = null; await Load();
        }
        catch (Exception e) { error = "Kunne ikke oprette: " + e.Message; }
    }

    // Autoudfyld valgte et sted: gem SOR-reference + udled brobygningstype hvis muligt
    private void StedValgt(Sted s)
    {
        form.StedSorId = string.IsNullOrEmpty(s.SorId) ? null : s.SorId;
        form.StedShak = string.IsNullOrEmpty(s.Shak) ? null : s.Shak;
    }

    private async Task Eksport()
    {
        try { var csv = await Api.EksportAftaler(); await JS.InvokeVoidAsync("downloadText", "aftaler.csv", csv); }
        catch (Exception e) { error = "Kunne ikke eksportere: " + e.Message; }
    }

    private async Task Skift(Guid id, string status)
    {
        try { await Api.SetAftaleStatus(id, status); await Load(); }
        catch (Exception e) { error = "Kunne ikke opdatere: " + e.Message; }
    }

    private void BrugSkabelon(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var id)) return;
        var sk = skabeloner.FirstOrDefault(x => x.Id == id);
        if (sk is null) return;
        var menneske = mennesker.FirstOrDefault(m => m.Id == form.MenneskeId)?.Navn ?? "";
        var brobygger = brobyggere.FirstOrDefault(b => b.Id == form.BrobyggerId)?.Navn ?? "";
        form.Beskrivelse = sk.Indhold
            .Replace("{menneske}", menneske)
            .Replace("{brobygger}", brobygger)
            .Replace("{sted}", form.Sted ?? "")
            .Replace("{dato}", dato.ToString("dd. MMM yyyy HH:mm"));
    }

    private string NavnM(Guid id) => mennesker.FirstOrDefault(x => x.Id == id)?.Navn ?? "—";
    private string NavnB(Guid id) => brobyggere.FirstOrDefault(x => x.Id == id)?.Navn ?? "—";
    private static string Pill(string s) => s switch { "confirmed" => "gron", "pending" => "gul", "aflyst" or "afslaaet" or "brudt" => "graa", _ => "" };
    private static string BtClass(string? bt) => (bt ?? "").ToLowerInvariant() switch { "social" => "social", "forening" => "forening", "sundhed" => "sundhed", _ => "" };
}
